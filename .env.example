# PostgreSQL (docker-compose)
# Compte d'administration : migrations et seed uniquement.
DATABASE_URL=postgres://expense:expense@localhost:5433/expense_io
# Compte applicatif non-superutilisateur, soumis à la RLS
# (migrations 0003/0005, ADR-DATA-002) : le serveur applicatif
# l'utilise en priorité (getPool). Mot de passe de développement
# uniquement, posé par le seed — production : secret dédié.
APP_DATABASE_URL=postgres://expense_app:expense_app_dev_only@localhost:5433/expense_io

# Auth.js — OBLIGATOIRE au démarrage, 32 caractères minimum.
# `make env` remplace automatiquement cette valeur d'exemple par un
# secret généré. Ne la conserve JAMAIS (même en local partagé) :
# le démarrage la refuse, car un secret public permet la forge de
# session. Generate with: npx auth secret
AUTH_SECRET=changeme-generate-a-real-secret-for-non-local-use
# Requis uniquement en production (`next start`/`npm run start`).
# AUTH_TRUST_HOST=true

# Stockage objet S3-compatible (LocalStack en local, docker-compose)
S3_ENDPOINT=http://localhost:4567
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=receipts
S3_FORCE_PATH_STYLE=true
